# Database (Neon/Vercel Postgres)
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Authentication (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Rate Limiting (Upstash Redis) - Optional for development
# Get these from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Payment (Stripe)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_OPIEKUN_STANDARD_PRICE_ID=
STRIPE_OPIEKUN_PREMIUM_PRICE_ID=
STRIPE_OPIEKUN_PREMIUM_UPGRADE_PRICE_ID=
STRIPE_PIELEGNIARSTWO_BASIC_PRICE_ID=
STRIPE_PIELEGNIARSTWO_PREMIUM_PRICE_ID=
STRIPE_PIELEGNIARSTWO_PREMIUM_UPGRADE_PRICE_ID=
STRIPE_OPIEKUN_BASIC_MONTHLY_PRICE_ID=
STRIPE_OPIEKUN_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_PIELEGNIARSTWO_BASIC_MONTHLY_PRICE_ID=
STRIPE_PIELEGNIARSTWO_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_OPIEKUN_PORTAL_CONFIGURATION_ID=
STRIPE_PIELEGNIARSTWO_PORTAL_CONFIGURATION_ID=

# File Upload (UploadThing)
UPLOADTHING_TOKEN=

# Error Tracking (Sentry)
SENTRY_AUTH_TOKEN=

# Google Vertex AI (RAG Engine, Gemini, Mind Map)
# Project + region for all Vertex AI calls. Defaults to the historical hardcoded
# values when unset, so local dev keeps working without these.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west3
# Production auth (Vercel): Vertex AI RAG Engine is OAuth2-only (no API key).
# Locally we use ADC from `gcloud auth application-default login`; serverless has
# no metadata server, so paste a service-account JSON key here, base64-encoded
# (`base64 -w0 key.json`). Leave empty locally to fall back to ADC.
# The service account needs the roles/aiplatform.user role.
GOOGLE_SERVICE_ACCOUNT_KEY=
# Set to "true" to log per-call Gemini token usage (prompt/candidates/thoughts).
RAG_DEBUG_USAGE=
# Google Cloud Text-to-Speech API key (lecture audio generation).
GOOGLE_TTS_API_KEY=

# Other
NEXT_PUBLIC_APP_URL=http://localhost:3000
